{
  "name": "@travora/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas and TypeScript types for Travora",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
