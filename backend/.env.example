# Copy this file to .env. Keep the real .env private and never commit it.

# Gemini API key from Google AI Studio; the default model has free-tier access.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Flight search and hotel search share Amadeus Self-Service credentials
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Places search and travel-time / route matrix
GOOGLE_MAPS_API_KEY=

# Current conditions and forecast
OPENWEATHER_API_KEY=

# Local app configuration
CORS_ORIGINS=http://localhost:5173
# TRAVEL_PLANNER_DB=./travel_planner.db
